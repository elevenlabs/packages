{
  "name": "elevenlabs-react-native-example",
  "version": "1.1.24",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "android": "echo '🚨🚨 Once Expo has started, press `a` 🚨🚨' && node --run dev",
    "ios": "echo '🚨🚨 Once Expo has started, press `i` 🚨🚨' && node --run dev",
    "web": "expo start --web",
    "build:android": "expo prebuild --platform android",
    "build:ios": "expo prebuild --platform ios",
    "check-types": "tsc --noEmit"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-dev-client",
        "expo-image-picker",
        "expo-splash-screen",
        "@expo/metro-runtime"
      ]
    }
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@elevenlabs/react-native": "workspace:*",
    "@expo/dom-webview": "~57.0.1",
    "@expo/log-box": "~57.0.2",
    "@expo/metro-runtime": "~57.0.8",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.2",
    "expo": "~57.0.11",
    "expo-dev-client": "~57.0.10",
    "expo-image-picker": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/node": "^20.8.0",
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3"
  }
}
