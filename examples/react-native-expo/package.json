{
  "name": "elevenlabs-react-native-example",
  "version": "1.1.40",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "expo prebuild --platform android",
    "build:ios": "expo prebuild --platform ios",
    "check-types": "tsc --noEmit",
    "test": "node --test"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-dev-client",
        "expo-image-picker",
        "expo-splash-screen",
        "@expo/metro-runtime"
      ]
    }
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@elevenlabs/react-native": "workspace:*",
    "@expo/dom-webview": "~58.0.2",
    "@expo/log-box": "~58.0.13",
    "@expo/metro-runtime": "~58.0.15",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.2",
    "expo": "~58.0.17",
    "expo-dev-client": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-splash-screen": "~58.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/node": "^20.8.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
