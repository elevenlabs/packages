{
  "name": "elevenlabs-react-native-example",
  "version": "1.1.26",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "android": "echo '🚨🚨 Once Expo has started, press `a` 🚨🚨' && node --run dev",
    "ios": "echo '🚨🚨 Once Expo has started, press `i` 🚨🚨' && node --run dev",
    "web": "expo start --web",
    "build:android": "expo prebuild --platform android",
    "build:ios": "expo prebuild --platform ios",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@elevenlabs/react-native": "workspace:*",
    "@expo/dom-webview": "~56.0.6",
    "@expo/log-box": "~56.0.14",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.2",
    "expo": "~56.0.17",
    "expo-dev-client": "~56.0.24",
    "expo-image-picker": "~56.0.22",
    "expo-splash-screen": "~56.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "~0.21.2",
    "@expo/metro-runtime": "~56.0.18"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/node": "^20.8.0",
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3"
  }
}
